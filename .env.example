# Application
# Shown on the Terms/Privacy pages so people can reach you about their data
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Neon PostgreSQL (leave empty in local dev to use the embedded dev database)
DATABASE_URL=

# Authentication (Auth.js) — generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Private object storage. Leave S3_BUCKET empty to store uploads on local disk (dev only).
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
LOCAL_STORAGE_DIR=.data/uploads
MAX_UPLOAD_MB=15

# AI provider: anthropic | openai | openai-compatible
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# Arc
# Arc MAINNET (verified against docs.arc.io): chain 5042, gas token USDC
ARC_CHAIN_ID=5042
ARC_RPC_URL=https://rpc.mainnet.arc.io
ARC_EXPLORER_URL=https://explorer.arc.io
# Safety cap: most credentials the app will ever submit per rolling 24h (each costs a little USDC gas)
ARC_MAX_ISSUANCES_PER_DAY=100
ARC_CREDENTIAL_CONTRACT_ADDRESS=
ARC_ISSUER_PRIVATE_KEY=
# Same explorer, exposed to the browser for transaction links (safe to be public)
NEXT_PUBLIC_ARC_EXPLORER_URL=

# Content-Security-Policy: report-only (default in production) | enforce | off. Switch to enforce after checking the browser console shows no violations.
CSP_MODE=

# Optional error tracking (Sentry DSN). Only errors, routes and request ids are sent — never user data.
SENTRY_DSN=

# Protects the job-sweep endpoint called by your scheduler
CRON_SECRET=

# Password-reset email (Resend). Without these, reset links are only returned in development.
RESEND_API_KEY=
EMAIL_FROM=
